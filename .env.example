# Paper mode is the safe default. Live orders require both flags.
TRADING_MODE=paper
ENABLE_LIVE_ORDERS=false
MARKET_DATA_ENABLED=true
STOCK_DATA_FEED=sip
OPTION_DATA_FEED=opra
HISTORY_DATABASE_ENABLED=true
MARKET_HISTORY_QUOTE_SAMPLE_MS=250
MARKET_HISTORY_RETENTION_DAYS=7
POSTGRES_PASSWORD=change-this-local-database-password
DATABASE_URL=postgresql://spy_options:change-this-local-database-password@postgres:5432/spy_options
ALPACA_API_KEY=
ALPACA_API_SECRET=
KILL_SWITCH=false
HEALTH_HOST=127.0.0.1
HEALTH_PORT=3001
TRADING_SYMBOLS=SPY,QQQ,TSLA
OPRA_MAX_SUBSCRIPTIONS=900
MARKET_DATA_MAX_PENDING_PER_SYMBOL=50000
MARKET_DATA_MAX_INTERNAL_LAG_MS=500
TRADE_UPDATE_MAX_PENDING_PER_SYMBOL=10000
LEADER_ELECTION_ENABLED=true
LEADER_LOCK_KEY=alpaca-options-engine
LEADER_HEARTBEAT_MS=5000
# Required only for TRADING_MODE=live.
LIVE_TRADING_CONFIRMATION=
